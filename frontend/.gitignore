# =============================================
# A2 CRAVINGS — .gitignore
# React + Vite project
# =============================================

# --- Dependencies (never commit, install via npm install) ---
node_modules/

# --- Production build output (generated, not source) ---
dist/
dist-ssr/
build/

# --- Environment & Secret files (NEVER commit) ---
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.env

# --- Credentials, Keys & Certificates ---
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
id_rsa*
secrets.*

# --- Vite & Framework cache ---
.vite/

# --- Editor & OS junk ---
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
.vscode/*
!.vscode/extensions.json
.idea/
*.code-workspace

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- TypeScript build info ---
*.tsbuildinfo

# --- Coverage & test artifacts ---
coverage/
.nyc_output/

# --- Misc ---
*.local
.cache/
